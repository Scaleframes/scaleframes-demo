# Copy to screego.env and fill in the values marked CHANGE.

# Public IPv4 of the server (CHANGE). The customer browser connects to the TURN relay here.
SCREEGO_EXTERNAL_IP=203.0.113.10
# Random string, at least 32 characters (CHANGE). Keeps sellers logged in after a restart.
# Make one with: openssl rand -hex 32
SCREEGO_SECRET=CHANGE_ME
SCREEGO_PUBLIC_URL=https://demo.scaleframes.com

# Only logged-in sellers can start a demo. Customers join without an account.
SCREEGO_AUTH_MODE=all
SCREEGO_USERS_FILE=/data/users
SCREEGO_SELLERS_FILE=/data/sellers.json
# Sellers stay logged in for 30 days.
SCREEGO_SESSION_TIMEOUT_SECONDS=2592000

# HubSpot private app token (CHANGE). Scopes: crm.objects.contacts.read,
# crm.objects.contacts.write, crm.objects.owners.read.
SCREEGO_HUBSPOT_TOKEN=

# The Cloudflare Tunnel sends traffic to this port on the same server.
SCREEGO_SERVER_ADDRESS=127.0.0.1:5050
SCREEGO_TRUST_PROXY_HEADERS=true
SCREEGO_TURN_ADDRESS=0.0.0.0:3478
SCREEGO_TURN_PORT_RANGE=50000:50200
SCREEGO_CLOSE_ROOM_WHEN_OWNER_LEAVES=true
SCREEGO_LOG_LEVEL=info
